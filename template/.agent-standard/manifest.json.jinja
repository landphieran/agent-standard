{
  "$schema": "./manifest.schema.json",
  "schemaVersion": 1,
  "standardVersion": "1.0.0",
  "standardRevision": "{{ standard_revision }}",
  "conformanceLevel": "AS-3",
  "conformance": {
    "target": "AS-3",
    "status": "{% if mode == 'adopt' or gate == 'advisory' or bom_gate == 'advisory' or not ci %}adopting{% else %}pending-remote{% endif %}",
    "localEnforcement": "{{ gate }}",
    "remoteEnforcement": "unverified"
  },
  "project": {
    "name": {{ project_name | tojson }},
    "packageName": {{ pkg | tojson }},
    "stack": "{{ language_stack }}",
    "packageManager": "{% if language_stack in ['ts-node', 'ts-next'] %}npm{% else %}uv{% endif %}",
    "architecture": "{{ architecture }}",
    "topology": "{{ topology }}",
    "mode": "{{ mode }}"
  },
  "platform": {
    "repository": "{{ repository_platform }}",
    "ci": "{% if not ci %}none{% elif repository_platform == 'github' %}github-actions{% else %}azure-pipelines{% endif %}",
    "pipelineMode": "{% if not ci %}none{% elif repository_platform == 'azure-devops' %}{{ azure_pipeline_mode }}{% else %}standalone{% endif %}"
  },
  "governance": {
    "owners": {{ owners | tojson }}
  },
  "agents": [{% for agent in agents %}"{{ agent }}"{% if not loop.last %}, {% endif %}{% endfor %}],
  "workflow": {
    "profile": "{{ workflow_profile }}",
    "engine": "{% if workflow_profile == 'spec-driven' %}openspec{% else %}native{% endif %}"
  },
  "commands": {
{%- if language_stack in ['ts-node', 'ts-next'] %}
    "install": "npm install",
    "verify": "node .agent-standard/scripts/verify.mjs",
    "updateBom": "npm run sbom"
{%- else %}
    "install": "uv sync",
    "verify": "node .agent-standard/scripts/verify.mjs",
    "updateBom": "node .agent-standard/scripts/sbom.mjs --write"
{%- endif %}
  },
  "documents": [
    "README.md",
{% if mode == 'greenfield' -%}
    "ARCHITECTURE.md",
{% endif -%}
    "SECURITY.md",
    "CONTRIBUTING.md",
{% if mode == 'adopt' -%}
    "docs/agent-standard.md",
{% else -%}
    "docs/README.md",
    "docs/decisions/README.md",
    "docs/runbooks/README.md",
{% endif -%}
    "docs/testing.md",
    "docs/topology.md"{% if workflow_profile == 'lightweight' %},
    "docs/changes/README.md"{% endif %}
  ],
  "skills": ["plan-change", "create-adr", "maintain-docs", "self-review", "security-review"],
  "qualityGate": {
    "mode": "{{ gate }}",
    "ci": {{ ci | lower }},
    "waivers": ".agent-standard/waivers.json"
  },
  "supplyChain": {
    "securityProfile": "{{ security_profile }}",
    "releaseAttestations": {{ release_attestations | lower }},
    "bom": {
      "mode": "{{ bom_gate }}",
      "formats": [{% if bom_format in ['cyclonedx-json', 'both'] %}"cyclonedx-json"{% endif %}{% if bom_format == 'both' %}, {% endif %}{% if bom_format in ['spdx-json', 'both'] %}"spdx-json"{% endif %}],
      "files": [{% if bom_format in ['cyclonedx-json', 'both'] %}"bom.cdx.json"{% endif %}{% if bom_format == 'both' %}, {% endif %}{% if bom_format in ['spdx-json', 'both'] %}"bom.spdx.json"{% endif %}]
    }
  }
}

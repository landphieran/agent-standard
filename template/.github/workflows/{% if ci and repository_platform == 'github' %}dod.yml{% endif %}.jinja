name: agent-standard
on:
  pull_request:
  push:

concurrency:
  group: {% raw %}agent-standard-${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  verify:
    name: definition-of-done
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
        with:
          fetch-depth: 0
      - uses: actions/setup-node@a0853c24544627f65ddf259abe73b1d18a591444 # v5
        with:
          node-version: "22"
{%- if language_stack in ['ts-node', 'ts-next'] %}
          cache: npm
      - run: npm ci
{%- if language_stack == 'ts-next' %}
      - run: npx playwright install --with-deps chromium
{%- endif %}
{%- elif language_stack == 'py-fastapi' %}
      - uses: astral-sh/setup-uv@37802adc94f370d6bfd71619e3f0bf239e1f3b78 # v7
        with:
          version: "0.10.8"
          enable-cache: true
      - run: uv sync --locked --all-groups
{%- endif %}
      - name: Verify repository contract
        run: node .agent-standard/scripts/verify.mjs
      - name: Verify change policy
        env:
          DOD_BASE: {% raw %}${{ github.event.pull_request.base.sha || github.event.before }}{% endraw %}
          DOD_HEAD: {% raw %}${{ github.event.pull_request.head.sha || github.sha }}{% endraw %}
        run: node .agent-standard/scripts/dod.mjs --ci --policy-only
{%- if bom_format in ['cyclonedx-json', 'both'] %}
      - name: Generate CycloneDX build SBOM
        uses: anchore/sbom-action@e22c389904149dbc22b58101806040fa8d37a610 # v0
        with:
          path: .
          format: cyclonedx-json
          output-file: build.bom.cdx.json
          artifact-name: {{ pkg }}-cyclonedx-sbom
          syft-version: v1.51.1
          upload-release-assets: false
{%- endif %}
{%- if bom_format in ['spdx-json', 'both'] %}
      - name: Generate SPDX build SBOM
        uses: anchore/sbom-action@e22c389904149dbc22b58101806040fa8d37a610 # v0
        with:
          path: .
          format: spdx-json
          output-file: build.bom.spdx.json
          artifact-name: {{ pkg }}-spdx-sbom
          syft-version: v1.51.1
          upload-release-assets: false
{%- endif %}

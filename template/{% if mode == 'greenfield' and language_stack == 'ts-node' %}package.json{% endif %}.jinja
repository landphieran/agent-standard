{
  "name": "{{ pkg }}",
  "version": "0.1.0",
  "description": "{{ project_name }}",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "verify:code": "npm run lint && npm run typecheck && npm test && npm run build",
    "agent:verify": "node .agent-standard/scripts/verify.mjs",
    "sbom": "node .agent-standard/scripts/sbom.mjs --write"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.0",
    "eslint": "10.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/landphieran/agent-standard/manifest.schema.json",
  "title": "agent-standard project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "standardVersion", "standardRevision", "conformanceLevel", "conformance", "project", "platform", "governance", "agents", "workflow", "commands", "documents", "skills", "qualityGate", "supplyChain"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "standardVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "standardRevision": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        { "const": "development" }
      ]
    },
    "conformanceLevel": { "enum": ["AS-1", "AS-2", "AS-3", "AS-4"] },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "status", "localEnforcement", "remoteEnforcement"],
      "properties": {
        "target": { "enum": ["AS-1", "AS-2", "AS-3", "AS-4"] },
        "status": { "enum": ["adopting", "pending-remote", "conformant", "drifted"] },
        "localEnforcement": { "enum": ["strict", "advisory"] },
        "remoteEnforcement": { "enum": ["unverified", "configured", "enforced", "drifted"] }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "packageName", "stack", "packageManager", "architecture", "topology", "mode"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "packageName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "stack": { "enum": ["ts-node", "ts-next", "py-fastapi"] },
        "packageManager": { "enum": ["npm", "uv"] },
        "architecture": { "enum": ["service-based", "clean-layered"] },
        "topology": { "enum": ["single-deployable", "modular-monolith", "distributed-services"] },
        "mode": { "enum": ["greenfield", "adopt"] }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ci", "pipelineMode"],
      "properties": {
        "repository": { "enum": ["github", "azure-devops"] },
        "ci": { "enum": ["none", "github-actions", "azure-pipelines"] },
        "pipelineMode": { "enum": ["none", "standalone", "extends"] }
      },
      "allOf": [
        {
          "if": { "properties": { "repository": { "const": "github" } }, "required": ["repository"] },
          "then": {
            "properties": {
              "ci": { "enum": ["none", "github-actions"] },
              "pipelineMode": { "enum": ["none", "standalone"] }
            }
          }
        },
        {
          "if": { "properties": { "repository": { "const": "azure-devops" } }, "required": ["repository"] },
          "then": { "properties": { "ci": { "enum": ["none", "azure-pipelines"] } } }
        },
        {
          "if": { "properties": { "ci": { "const": "none" } }, "required": ["ci"] },
          "then": { "properties": { "pipelineMode": { "const": "none" } } },
          "else": { "properties": { "pipelineMode": { "enum": ["standalone", "extends"] } } }
        }
      ]
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owners"],
      "properties": { "owners": { "type": "string", "pattern": "^@[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)?( +@[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)?)*$" } }
    },
    "agents": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["claude", "codex", "copilot"] } },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "engine"],
      "properties": {
        "profile": { "enum": ["lightweight", "spec-driven"] },
        "engine": { "enum": ["native", "openspec"] }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install", "verify", "updateBom"],
      "properties": {
        "install": { "type": "string", "minLength": 1 },
        "verify": { "type": "string", "minLength": 1 },
        "updateBom": { "type": "string", "minLength": 1 }
      }
    },
    "documents": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$" } },
    "skills": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } },
    "qualityGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "ci", "waivers"],
      "properties": {
        "mode": { "enum": ["strict", "advisory"] },
        "ci": { "type": "boolean" },
        "waivers": { "const": ".agent-standard/waivers.json" }
      }
    },
    "supplyChain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["securityProfile", "releaseAttestations", "bom"],
      "properties": {
        "securityProfile": { "enum": ["baseline", "hardened"] },
        "releaseAttestations": { "type": "boolean" },
        "bom": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "formats", "files"],
          "properties": {
            "mode": { "enum": ["strict", "advisory"] },
            "formats": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["cyclonedx-json", "spdx-json"] } },
            "files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["bom.cdx.json", "bom.spdx.json"] } }
          }
        }
      }
    }
  }
}

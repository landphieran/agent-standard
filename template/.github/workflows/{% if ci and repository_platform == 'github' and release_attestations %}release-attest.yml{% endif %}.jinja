name: release-attest
on:
  push:
    tags: ["v*"]
permissions:
  contents: read
  id-token: write
  attestations: write
jobs:
  attest:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
      - uses: actions/setup-node@a0853c24544627f65ddf259abe73b1d18a591444 # v5
        with:
          node-version: "22"
{%- if language_stack in ['ts-node', 'ts-next'] %}
          cache: npm
      - run: npm ci
      - run: npm run build
{%- else %}
      - uses: astral-sh/setup-uv@37802adc94f370d6bfd71619e3f0bf239e1f3b78 # v7
        with:
          version: "0.10.8"
      - run: uv sync --locked --all-groups
{%- endif %}
{%- if bom_format in ['cyclonedx-json', 'both'] %}
      - uses: anchore/sbom-action@e22c389904149dbc22b58101806040fa8d37a610 # v0
        with:
          path: .
          format: cyclonedx-json
          output-file: release.bom.cdx.json
          upload-artifact: false
          upload-release-assets: false
          syft-version: v1.51.1
      - uses: actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6 # v4
        with:
          subject-path: "{% if language_stack == 'ts-node' %}dist/**{% elif language_stack == 'ts-next' %}.next/**{% else %}src/**{% endif %}"
          sbom-path: release.bom.cdx.json
{%- endif %}
{%- if bom_format in ['spdx-json', 'both'] %}
      - uses: anchore/sbom-action@e22c389904149dbc22b58101806040fa8d37a610 # v0
        with:
          path: .
          format: spdx-json
          output-file: release.bom.spdx.json
          upload-artifact: false
          upload-release-assets: false
          syft-version: v1.51.1
      - uses: actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6 # v4
        with:
          subject-path: "{% if language_stack == 'ts-node' %}dist/**{% elif language_stack == 'ts-next' %}.next/**{% else %}src/**{% endif %}"
          sbom-path: release.bom.spdx.json
{%- endif %}

{
  "name": "agent-standard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "agent-standard": "./bin/agent-standard.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs && node scripts/verify-source.mjs",
    "test:gate": "node --test test/gate.test.mjs",
    "verify:source": "node scripts/verify-source.mjs",
    "verify:renders": "node scripts/run-render-verifier.mjs",
    "sbom": "node template/.agent-standard/scripts/sbom.mjs --write"
  }
}

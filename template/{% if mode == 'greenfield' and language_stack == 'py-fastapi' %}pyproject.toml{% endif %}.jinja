[project]
name = "{{ pkg }}"
version = "0.1.0"
description = "{{ project_name }}"
requires-python = ">=3.10"
dependencies = ["fastapi>=0.110", "httpx>=0.27"]

[dependency-groups]
dev = ["pytest>=8"]

[tool.pytest.ini_options]
pythonpath = ["src"]
testpaths = ["tests"]
markers = ["integration: end-to-end/integration tests"]
addopts = "--strict-markers"

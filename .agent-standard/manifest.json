{
  "$schema": "../template/.agent-standard/manifest.schema.json",
  "schemaVersion": 1,
  "standardVersion": "0.6.0-dev",
  "conformanceLevel": "AS-3",
  "conformance": {
    "target": "AS-3",
    "status": "adopting",
    "localEnforcement": "strict",
    "remoteEnforcement": "unverified"
  },
  "project": {
    "name": "agent-standard",
    "packageName": "agent-standard",
    "stack": "ts-node",
    "packageManager": "npm",
    "architecture": "service-based",
    "topology": "single-deployable",
    "mode": "adopt"
  },
  "platform": {
    "repository": "github",
    "ci": "github-actions",
    "pipelineMode": "standalone"
  },
  "governance": { "owners": "@landphieran" },
  "agents": ["codex", "claude", "copilot"],
  "workflow": { "profile": "lightweight", "engine": "native" },
  "commands": {
    "install": "npm install",
    "verify": "npm test",
    "updateBom": "npm run sbom"
  },
  "documents": ["README.md", "AGENTS.md", "SECURITY.md", "CONTRIBUTING.md", "docs/architecture.md", "docs/configuration.md", "docs/runbook.md"],
  "skills": ["plan-change", "create-adr", "maintain-docs", "self-review", "security-review"],
  "qualityGate": { "mode": "strict", "ci": true, "waivers": ".agent-standard/waivers.json" },
  "supplyChain": {
    "securityProfile": "baseline",
    "releaseAttestations": false,
    "bom": { "mode": "strict", "formats": ["cyclonedx-json"], "files": ["bom.cdx.json"] }
  }
}
